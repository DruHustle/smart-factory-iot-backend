# Render backend production template. Add these variables to the Render service;
# never commit real production values.
SERVICE_NAME=DeviceService
ASPNETCORE_ENVIRONMENT=Production
DATABASE_URL=postgresql://avnadmin:CHANGE_ME_URL_ENCODED_PASSWORD@CHANGE_ME_AIVEN_HOST:CHANGE_ME_PORT/smart_factory_dashboard?sslmode=require
DATABASE_CA_CERT=CHANGE_ME_COMPLETE_AIVEN_CA_PEM
DEVICE_DATABASE_CONNECTION=Host=CHANGE_ME_AIVEN_HOST;Port=CHANGE_ME_PORT;Database=smart_factory_devices;Username=avnadmin;Password=CHANGE_ME_PASSWORD;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem
TELEMETRY_DATABASE_CONNECTION=Host=CHANGE_ME_AIVEN_HOST;Port=CHANGE_ME_PORT;Database=smart_factory_telemetry;Username=avnadmin;Password=CHANGE_ME_PASSWORD;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem
JWT_SECRET=CHANGE_ME_SHARED_DASHBOARD_SECRET_AT_LEAST_32_BYTES
ConnectionStrings__DefaultConnection=Host=CHANGE_ME;Port=5432;Database=smart_factory_devices;Username=CHANGE_ME;Password=CHANGE_ME;SSL Mode=VerifyFull;Root Certificate=/etc/secrets/aiven-ca.pem
REDIS_URL=rediss://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:CHANGE_ME_PORT/0
APPLY_DATABASE_MIGRATIONS=false
MIGRATION_ONLY=false
AAS_PROVISIONING_TOKEN=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
INGESTION_API_TOKEN=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
DASHBOARD_SERVICE_TOKEN=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
ALLOWED_ORIGIN=https://CHANGE_ME_VERCEL_HOST

MqttBrokerHost=CHANGE_ME_MQTT_HOST
MqttBrokerPort=8883
MqttUsername=CHANGE_ME_COMMAND_PUBLISHER_USER
MqttPassword=CHANGE_ME_MQTT_PASSWORD
MqttUseTls=true
MqttClientId=smart-factory-telemetry-production
MqttTopic=factory/+/+/+/telemetry
MqttHeartbeatTopic=factory/+/+/+/heartbeat
EDGE_SITE_ID=factory-a
EDGE_LINE_ID=line-1

AAS_REPOSITORY_URL=
AAS_SUBMODEL_REPOSITORY_URL=
AAS_CONCEPT_DESCRIPTION_REPOSITORY_URL=
AAS_REGISTRY_URL=
AAS_SUBMODEL_REGISTRY_URL=
AASX_FILE_SERVER_URL=
AAS_REPOSITORY_REGISTRY_INTEGRATION=true
AAS_ALLOW_UNAUTHENTICATED_LOCAL=false
AAS_ALLOW_UNAUTHENTICATED_PRIVATE=false
AAS_OIDC_TOKEN_URL=
AAS_OIDC_DISCOVERY_URL=
AAS_OIDC_SCOPE=
AAS_OIDC_CLIENT_ID=
AAS_OIDC_CLIENT_SECRET=

# Transactional email. Use credentials belonging to a least-privilege SES
# SendEmail-only IAM principal; never install AWS root credentials.
EMAIL_PROVIDER=ses
SES_ENABLED=true
SES_REGION=us-east-1
SES_FROM=Smart Factory IoT <smartfactory.notifications@gmail.com>
# Keep false in the SES sandbox and list only verified test recipients. Change
# to true only after SES production access is approved.
SES_ALLOW_ALL_RECIPIENTS=false
SES_ALLOWED_RECIPIENTS=smartfactory.notifications@gmail.com
SES_ALLOWED_RECIPIENT_DOMAINS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Legacy Resend alternative. Configure all three only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
RESEND_FROM=Smart Factory <notifications@CHANGE_ME_VERIFIED_DOMAIN>
RESEND_ALLOWED_RECIPIENT_DOMAINS=CHANGE_ME_COMPANY_DOMAIN

#Demo accounts and demo data 
ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_DATA=false
