# Local Compose only. Copy to .env and replace every CHANGE_ME value.
# Generate independent values with: openssl rand -hex 32
POSTGRES_USER=smartfactory_local
POSTGRES_PASSWORD=CHANGE_ME_UNIQUE_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=SmartFactory
# Compose runs the DeviceService EF migration on its single local instance.
APPLY_DATABASE_MIGRATIONS=true
RABBITMQ_DEFAULT_USER=smartfactory_local
RABBITMQ_DEFAULT_PASS=CHANGE_ME_DIFFERENT_RANDOM_BROKER_PASSWORD
# DeviceService publishes short-lived desired-state and control commands. For a
# physical Pi, use the Pi's external broker with a separate publish-only account
# restricted to factory/+/+/+/commands. Defaults retain local Compose behavior.
EDGE_COMMAND_MQTT_HOST=rabbitmq
EDGE_COMMAND_MQTT_PORT=1883
EDGE_COMMAND_MQTT_USERNAME=smartfactory_local
EDGE_COMMAND_MQTT_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_BROKER_PASSWORD
EDGE_COMMAND_MQTT_USE_TLS=false
# TelemetryService subscribes to this broker; defaults to the local RabbitMQ
# container. For a physical Pi using CloudAMQP, use a dedicated subscribe-only
# account and set its host, port 8883, username/password, and TLS=true here.
TELEMETRY_MQTT_HOST=rabbitmq
TELEMETRY_MQTT_PORT=1883
TELEMETRY_MQTT_USERNAME=smartfactory_local
TELEMETRY_MQTT_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_BROKER_PASSWORD
TELEMETRY_MQTT_USE_TLS=false
TELEMETRY_MQTT_TOPIC=factory/+/+/+/telemetry
TELEMETRY_MQTT_HEARTBEAT_TOPIC=factory/+/+/+/heartbeat
# These three services read the dashboard schema through the shared Docker network.
# Use the dashboard database password here; keep broker/backend DB passwords separate.
DASHBOARD_DATABASE_CONNECTION=Host=database;Database=smart_factory_iot;Username=smartfactory_local;Password=CHANGE_ME_DASHBOARD_DATABASE_PASSWORD;SSL Mode=Disable
DASHBOARD_SERVICE_TOKEN=CHANGE_ME_RANDOM_SERVICE_TOKEN_OF_AT_LEAST_32_BYTES
# Optional Graph email; configure all fields together or leave all empty.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_USER=
GRAPH_ALLOWED_RECIPIENT_DOMAINS=
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
INGESTION_API_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SERVICE_TOKEN
INTERNAL_TELEMETRY_SINK_URL=http://dashboard:3000/api/internal/telemetry

# Shared only between the dashboard API and private DeviceService.
AAS_PROVISIONING_TOKEN=CHANGE_ME_SEPARATE_32_BYTE_PROVISIONING_SERVICE_TOKEN
REDIS_PASSWORD=CHANGE_ME_DIFFERENT_LOCAL_REDIS_PASSWORD
DEVICE_SERVICE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
AAS_REPOSITORY_URL=http://aas-repository:8081
AAS_SUBMODEL_REPOSITORY_URL=http://submodel-repository:8083
AAS_CONCEPT_DESCRIPTION_REPOSITORY_URL=http://concept-description-repository:8085
AAS_REGISTRY_URL=http://aas-registry:8082
AAS_SUBMODEL_REGISTRY_URL=http://submodel-registry:8084
AAS_REPOSITORY_REGISTRY_INTEGRATION=true
AAS_ALLOW_UNAUTHENTICATED_LOCAL=true
# Production-only opt-in for the bundled BaSyx service DNS names. The services
# must remain on a private container network and must not be internet-exposed.
AAS_ALLOW_UNAUTHENTICATED_PRIVATE=false
# Configure either a direct token URL or OIDC discovery URL; client credentials stay in the runtime secret store.
AAS_OIDC_TOKEN_URL=
AAS_OIDC_DISCOVERY_URL=
AAS_OIDC_SCOPE=
AAS_OIDC_CLIENT_ID=
AAS_OIDC_CLIENT_SECRET=
AASX_FILE_SERVER_URL=http://aasx-file-server:8086
EDGE_SITE_ID=factory-a
EDGE_LINE_ID=line-1
